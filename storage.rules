rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Staff access requires secure Firebase Authentication Custom Claims or verified admin identity
    function hasStaffClaim() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role in ['admin', 'manager', 'operator']) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['manager']) && request.auth.token.manager == true) ||
        (request.auth.token.keys().hasAny(['operator']) && request.auth.token.operator == true) ||
        (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.matches('(?i)^(elmarmmdov1|rzayevnicat00)@gmail[.]com$'))
      );
    }

    // Supported MIME and extensions for documents, images, and videos
    function isAllowedFileType() {
      return request.resource.contentType.matches('.*');
    }

    function hasAllowedExtension(fileName) {
      return fileName.matches('.*\\.(?i)(pdf|doc|docx|xls|xlsx|ppt|pptx|jpg|jpeg|png|webp|gif|bmp|mp4|mov|avi|mkv|zip|rar|7z|txt|csv)$') ||
             !fileName.matches('.*\\..*');
    }

    // Maximum file size: 100 MB
    function isUnderSizeLimit() {
      return request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024;
    }

    // Orders files path: users/{userId}/orders/{orderId}/files/{fileName}
    match /users/{userId}/orders/{orderId}/files/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isUnderSizeLimit();
      allow delete: if isAuthenticated();
    }

    match /orders/{orderId}/files/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isUnderSizeLimit();
      allow delete: if isAuthenticated();
    }

    // User Profile Photos: profile_images/{userId}/{fileName}
    match /profile_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if (isOwner(userId) || hasStaffClaim())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId) || hasStaffClaim();
    }

    // Story Media: stories/{userId}/{fileName}
    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow write: if (isOwner(userId) || hasStaffClaim())
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if isOwner(userId) || hasStaffClaim();
    }

    // Chat attachments: chat_attachments/{conversationId}/{fileName}
    match /chat_attachments/{conversationId}/{fileName} {
      allow read, write: if isAuthenticated()
                         && request.resource.size < 25 * 1024 * 1024;
      allow delete: if hasStaffClaim();
    }
  }
}
