rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Staff access requires secure Firebase Authentication Custom Claims or verified admin identity
    function hasStaffClaim() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role in ['admin', 'manager', 'operator']) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['manager']) && request.auth.token.manager == true) ||
        (request.auth.token.keys().hasAny(['operator']) && request.auth.token.operator == true) ||
        (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.matches('(?i)^(elmarmmdov1|rzayevnicat00)@gmail[.]com$'))
      );
    }

    // Supported MIME types: PDF, DOC, DOCX, PPT, PPTX, JPG, JPEG, PNG, MP4
    function isAllowedFileType() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'image/jpeg',
        'image/png',
        'video/mp4'
      ];
    }

    // Restrict file extensions to authorized academic and document types
    function hasAllowedExtension(fileName) {
      return fileName.matches('.*\\.(pdf|doc|docx|ppt|pptx|jpg|jpeg|png|mp4)$') ||
             fileName.matches('.*\\.(PDF|DOC|DOCX|PPT|PPTX|JPG|JPEG|PNG|MP4)$');
    }

    // Maximum file size: 50 MB
    function isUnderSizeLimit() {
      return request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024;
    }

    // Orders files path: users/{userId}/orders/{orderId}/files/{fileName}
    match /users/{userId}/orders/{orderId}/files/{fileName} {
      // Owner or Staff can read files
      allow read: if isOwner(userId) || hasStaffClaim();

      // Authenticated customer owner or authorized staff can upload
      // Strictly validates MIME type, extension, and file size (max 50MB)
      allow create, update: if (isOwner(userId) || hasStaffClaim())
                            && isAllowedFileType()
                            && hasAllowedExtension(fileName)
                            && isUnderSizeLimit();

      // Only owner or staff can delete
      allow delete: if isOwner(userId) || hasStaffClaim();
    }
  }
}
