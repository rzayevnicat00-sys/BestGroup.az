rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Secure Custom Claims validation
    function hasStaffClaim() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role in ['admin', 'manager', 'operator']) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['manager']) && request.auth.token.manager == true) ||
        (request.auth.token.keys().hasAny(['operator']) && request.auth.token.operator == true)
      );
    }

    function hasAdminClaim() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email in ['elmarmmdov1@gmail.com', 'rzayevnicat00@gmail.com'] ||
          request.auth.token.email.matches('(?i)^(elmarmmdov1|rzayevnicat00)@gmail[.]com$')
        )
      );
    }

    function isDocAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['role']) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'operator', 'ADMIN', 'MANAGER', 'OPERATOR'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^(admin|manager|operator)$')
        )
      );
    }

    // Role check: super admin (elmarmmdov1@gmail.com, rzayevnicat00@gmail.com), custom claims, or user document role
    function isAdmin() {
      return isSuperAdmin() || hasAdminClaim() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['role']) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'ADMIN'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^admin$')
        )
      );
    }

    function isStaff() {
      return isSuperAdmin() || hasStaffClaim() || isDocAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // On registration, role must strictly default to customer (or admin if super admin)
      allow create: if isOwner(userId) && (request.resource.data.role == 'customer' || isSuperAdmin() || isAdmin());
      // User can update profile, admin can update any user
      allow update: if isOwner(userId) || isStaff() || isAdmin();
      allow delete: if isAdmin();

      // Devices Subcollection for secure FCM tokens
      match /devices/{deviceId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isStaff() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Customer can create only their own orders with waiting/pending status
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['waiting', 'pending'] &&
        (!request.resource.data.keys().hasAny(['assignedStaffId', 'assignedOperatorId']) || request.resource.data.assignedStaffId == null);

      // Updates: Staff can update any order. Customers can only update non-restricted fields on their own orders.
      // Customers CANNOT alter: userId, orderId, orderNumber, status, or staff assignments.
      allow update: if isStaff() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.orderNumber == resource.data.orderNumber &&
        request.resource.data.status == resource.data.status &&
        (!request.resource.data.keys().hasAny(['assignedStaffId']) || request.resource.data.assignedStaffId == resource.data.assignedStaffId)
      );

      allow delete: if isAdmin();
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      // Cross-document ownership validation:
      // For general conversations (orderId null or empty), order linkage is not required.
      // For order-linked conversations (orderId provided), the referenced order MUST exist AND belong to request.auth.uid.
      function orderBelongsToCaller(orderId) {
        return (orderId == null || orderId == '') || (
          exists(/databases/$(database)/documents/orders/$(orderId)) &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        );
      }

      // Read single conversation: staff, non-existent document check, or verified conversation customer
      allow get: if isAuthenticated() && (
        isStaff() ||
        resource == null ||
        resource.data.customerId == request.auth.uid
      );

      // List conversations: only staff or the verified conversation customer
      allow list: if isAuthenticated() && (
        isStaff() ||
        resource.data.customerId == request.auth.uid
      );

      // Create conversation: customer creates strictly for themselves and MUST own the order if specified
      allow create: if isAuthenticated() && (
        isStaff() ||
        (
          request.resource.data.customerId == request.auth.uid &&
          orderBelongsToCaller(request.resource.data.orderId) &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.status == 'active' &&
          (!request.resource.data.keys().hasAny(['assignedStaffId']) || request.resource.data.assignedStaffId == null) &&
          (!request.resource.data.keys().hasAny(['unreadForStaff']) || request.resource.data.unreadForStaff == 0)
        )
      );

      // Update conversation:
      // Customer cannot modify security-sensitive fields:
      // customerId, orderId, conversationId, assignedStaffId, status, unreadForStaff, createdAt
      allow update: if isAuthenticated() && (
        isStaff() ||
        (
          resource.data.customerId == request.auth.uid &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.conversationId == resource.data.conversationId &&
          (
            (!resource.data.keys().hasAny(['orderId']) && !request.resource.data.keys().hasAny(['orderId'])) ||
            request.resource.data.orderId == resource.data.orderId
          ) &&
          (!resource.data.keys().hasAny(['assignedStaffId']) || request.resource.data.assignedStaffId == resource.data.assignedStaffId) &&
          (!resource.data.keys().hasAny(['status']) || request.resource.data.status == resource.data.status) &&
          (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt)
        )
      );

      allow delete: if isAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        function parentConversationExists() {
          return exists(/databases/$(database)/documents/conversations/$(conversationId));
        }

        function getParentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        // Read messages: customer of this conversation or staff
        allow read: if isAuthenticated() && (
          isStaff() ||
          (parentConversationExists() && getParentConversation().customerId == request.auth.uid)
        );

        // Create message:
        // - Authenticated
        // - Staff or verified conversation owner
        // - Customer senderId MUST strictly match request.auth.uid
        // - Customer senderRole MUST be 'customer' (cannot impersonate staff)
        // - text size between 1 and 4000 characters
        allow create: if isAuthenticated() && (
          isStaff() ||
          (
            parentConversationExists() &&
            getParentConversation().customerId == request.auth.uid &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.senderRole == 'customer' &&
            request.resource.data.conversationId == conversationId &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0
          )
        );

        // Update message: customer can only update read status of incoming staff messages
        // Customer CANNOT alter senderId, senderRole, conversationId, messageId, text, messageType or createdAt
        allow update: if isAuthenticated() && (
          isStaff() ||
          (
            parentConversationExists() &&
            getParentConversation().customerId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.senderRole == resource.data.senderRole &&
            request.resource.data.conversationId == resource.data.conversationId &&
            request.resource.data.text == resource.data.text
          )
        );

        allow delete: if isAdmin();
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create, delete: if isStaff() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    // Services Catalog (Publicly readable, staff-writable)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // App Updates & Version Releases (Publicly readable, staff/admin writable)
    match /app_updates/{updateId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Stories Collection (Publicly readable, authenticated writable)
    match /stories/{storyId} {
      allow read: if true;
      allow create, delete, update: if isAuthenticated();
    }
  }
}
